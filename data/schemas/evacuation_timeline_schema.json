{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evacuation Event Timeline Schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "event_id": {
        "type": "string"
      },
      "time_seconds": {
        "type": "number",
        "minimum": 0
      },
      "time_formatted": {
        "type": "string"
      },
      "severity": {
        "type": "string",
        "enum": [
          "INFO",
          "WARNING",
          "CRITICAL",
          "FATAL"
        ]
      },
      "category": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "location_coordinates": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "required": [
      "event_id",
      "time_seconds",
      "time_formatted",
      "severity",
      "description"
    ]
  }
}